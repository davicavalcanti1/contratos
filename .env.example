# Copie para .env no servidor (ou cole nas variáveis do host). Nunca commitar o .env.
# Ver docs/OPERACAO.md.

NODE_ENV=production
PORT=3000
# URL pública. Vai nos links, nos e-mails e no QR impresso no PDF: não trocar depois do primeiro contrato assinado.
BASE_URL=https://bullacheck.com.br

# Banco e arquivos (Supabase). A chave é a service_role: só aqui.
SUPABASE_URL=https://gjpfplwirjterbkrybds.supabase.co
SUPABASE_KEY=
# Onde fica o diário de escritas pendentes do Supabase. Precisa ser disco persistente.
DADOS_DIR=/app/dados

# E-mail real (Resend). Sem domínio verificado, use EMAIL_REMETENTE=onboarding@resend.dev
# e só o e-mail da própria conta Resend recebe. Com o domínio verificado:
RESEND_API_KEY=
EMAIL_REMETENTE=BullaCheck <contrato@bullacheck.com.br>
EMAIL_RESPONDER_PARA=
# Para subir SEM e-mail de propósito (demonstração fechada): EMAIL_TRANSPORTE=caixa

# Carimbo do tempo RFC 3161 (opcional; vazio = desligado). Ver docs/PLUGAVEIS.md.
CARIMBO_URL=
CARIMBO_NOME=
CARIMBO_ICP_BRASIL=
CARIMBO_USUARIO=
CARIMBO_SENHA=
